# ==============================================================================
# OpenCampus API - Variables de Entorno de Ejemplo
# ==============================================================================

# URL base de la aplicación (para llamadas internas y composición SOA)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Credenciales de Supabase (Nivel gratuito)
# Obtén estas credenciales en: https://app.supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave de servicio de Supabase (SOLO PARA BACKEND / NUNCA EN EL FRONTEND)
# Opcional en el modo público/lectura, requerida si se administran datos con bypass RLS
SUPABASE_SERVICE_ROLE_KEY=

# Clave maestra opcional para el panel de administración de demostración
ADMIN_API_KEY=opencampus-admin-secret-dev-2026

# Fuentes Externas (APIs públicas gratuitas y abiertas)
# USGS Earthquake GeoJSON: No requiere clave
USGS_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary
# Open-Meteo Weather: No requiere clave
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
# Datos Abiertos Colombia (Portal de Datos Abiertos Gov.co / IDEAM / SGC)
DATOS_GOV_CO_URL=https://www.datos.gov.co/resource
